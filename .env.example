# Solo para la ejecucion LOCAL con docker compose (en Render las variables se
# configuran en el panel). Copiar como .env y completar; .env NO se sube al repositorio.

# oracle -> Oracle Autonomous Database (requiere wallet/ y ORACLE_PASSWORD)
# local  -> H2 en memoria con datos de ejemplo (para probar sin base de datos)
PERFIL=oracle

# Alias del tnsnames.ora del Wallet y credenciales del esquema FORO
TNS_ALIAS=fullstack3_tp
ORACLE_USER=FORO
ORACLE_PASSWORD=

# Secreto compartido para firmar y validar el JWT: el MISMO en los tres servicios.
# Generar uno con:  openssl rand -base64 48
FORO_JWT_SECRETO=

# Origenes permitidos por CORS, separados por coma. Solo hace falta si el
# frontend llama a la API (esta entrega no lo hace).
FORO_CORS_ORIGENES=http://localhost:*
