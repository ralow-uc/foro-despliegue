# Copiar como .env y completar. El archivo .env NO se sube al repositorio.

# Usuario de Docker Hub donde estan publicadas las imagenes
DOCKERHUB_USUARIO=tu-usuario-dockerhub

# oracle -> Oracle Autonomous Database (requiere wallet/ y ORACLE_PASSWORD)
# local  -> H2 en memoria con datos de ejemplo (para probar sin base de datos)
PERFIL=oracle

# Alias del tnsnames.ora del Wallet y credenciales del esquema FORO
TNS_ALIAS=fullstack3_tp
ORACLE_USER=FORO
ORACLE_PASSWORD=

# Secreto compartido para firmar y validar el JWT: el MISMO en los tres servicios.
# Generar uno con:  openssl rand -base64 48
FORO_JWT_SECRETO=

# URL publica del frontend (Play with Docker la muestra al abrir el puerto 80).
# Separar varias con coma. Solo hace falta si el frontend llama a la API.
FORO_CORS_ORIGENES=http://localhost:*,https://*.direct.labs.play-with-docker.com,http://*.direct.labs.play-with-docker.com
